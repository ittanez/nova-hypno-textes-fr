# Google Maps API Key
# Obtenez votre clé sur : https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=votre_clé_api_ici

# Google Ads — suivi des conversions (facultatif)
# Sans ces variables, aucune conversion n'est envoyée et rien n'est chargé en plus.
# Identifiant du compte, visible dans Google Ads > Outils > Conversions.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Libellés des actions de conversion, relevés dans Google Ads > Outils > Conversions
VITE_GOOGLE_ADS_LABEL_BOOKING=
VITE_GOOGLE_ADS_LABEL_PHONE=
VITE_GOOGLE_ADS_LABEL_FORM=
