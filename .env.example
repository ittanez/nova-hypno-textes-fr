# Google Maps API Key
# Obtenez votre clé sur : https://console.cloud.google.com/google/maps-apis/credentials
VITE_GOOGLE_MAPS_API_KEY=votre_clé_api_ici

# Google Ads — suivi des conversions (facultatif)
# Sans ces variables, aucune conversion n'est envoyée et rien n'est chargé en plus.
# Identifiant du compte (commun à tout le compte), visible dans Google Ads >
# Objectifs > Récapitulatif > une action de conversion > extrait d'événement.
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX
# Noms d'événement de chaque action de conversion (méthode « Clic »), relevés
# au même endroit, propres à chaque action.
VITE_GOOGLE_ADS_EVENT_BOOKING=
VITE_GOOGLE_ADS_EVENT_PHONE=
VITE_GOOGLE_ADS_EVENT_FORM=
